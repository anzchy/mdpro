{
  /*
   * Type-checks `tests/` without putting it on the build path.
   *
   * `pnpm build` runs bare `tsc`, which reads tsconfig.json — and that file
   * deliberately includes only `src`. Adding `tests` there would make every
   * test-fixture type error a release blocker. This config is invoked by
   * `pnpm typecheck:tests` instead, so test types are enforced on their own.
   */
  "extends": "./tsconfig.json",
  "include": ["src", "tests"]
}
