# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Test coverage reports
coverage/
.gstack/

# Pre-PR gate process artifacts (sibling-scan note, etc.) — not part of any commit
.pre-pr/
.prompts/

# tdd-guardian generated artifacts. The timestamped run reports accumulate one
# file per invocation and are outputs, not inputs — globbed by prefix rather
# than ignoring the directory, so `config.json` (the tracked input) and any new
# kind of file stay visible instead of disappearing silently.
.claude/tdd-guardian/state.json
.claude/tdd-guardian/receipts.json
.claude/tdd-guardian/coverage-*.md
.claude/tdd-guardian/plan-*.md
.claude/tdd-guardian/tests-*.md
.claude/tdd-guardian/review-*.md
.claude/tdd-guardian/mutation-*.md
.claude/tdd-guardian/attack-*.md
/.stryker-tmp

# cc-suite audit output (/cc-suite:audit findings tables) — regenerated per run
.cc-suite/

# Session context snapshots (/context-save, /retro) — local to one machine
.context/

# vmark editor workspace metadata. Unanchored on purpose: vmark writes a
# .vmark/ directory into whichever folder it opens, so this must match at any
# depth (currently /.vmark/ and /docs/plans/.vmark/), not just the repo root.
.vmark/

# Image-path fixtures for manual QA — a binary PNG plus scratch markdown, never
# loaded by the Vitest suite (vitest.config.ts includes tests/**/*.test.ts only)
tests/image-test/

# Large-document performance corpus written by scripts/perf/generate-corpus.mjs
# (default --out). ~50 MiB across 11 files, regenerable byte-for-byte from the
# committed generator, so the generator is the source input and this is not.
.perf-corpus/

# Orphaned Stryker config. Mutation testing was decided NOT to be adopted
# (sequencing doc 1.7, 「已决：不入库」) and requireMutation stays false, so
# nothing reads this file. Ignored rather than deleted — see the hygiene report;
# deleting it is the cleaner end state.
stryker.config.json

# D76: collect-assets output (scripts/release/collect-assets.mjs)
dist-release/

# Per-machine Claude Code tool state (D215): rewritten by every session, so a
# tracked copy only ever shows up as someone's unrelated dirty file.
.claude/scheduled_tasks.lock
.claude/nlpm-history.json
