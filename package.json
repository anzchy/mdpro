{
  "name": "tauri-app",
  "private": true,
  "version": "0.3.2",
  "type": "module",
  "packageManager": "pnpm@10.26.1",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/deps/check-patched.mjs && tsc && vite build",
    "postinstall": "node scripts/deps/check-patched.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest",
    "test:run": "vitest run",
    "coverage": "vitest run --coverage",
    "test:heavy": "scripts/heavy-lock.sh vitest run --coverage",
    "test:slow": "scripts/heavy-lock.sh vitest run --config vitest.slow.config.ts",
    "tauri:build:locked": "scripts/heavy-lock.sh tauri build",
    "perf:d12": "vitest run --config vitest.perf.config.ts",
    "typecheck:tests": "tsc -p tsconfig.test.json",
    "ledger:check": "node scripts/ledger/check.mjs",
    "ledger:build": "node scripts/ledger/render.mjs",
    "control:build": "node scripts/control/build.mjs",
    "control:doctor": "node scripts/control/doctor.mjs",
    "control:launch": "node scripts/control/launch.mjs",
    "control:quit": "node scripts/control/quit.mjs",
    "control:clean": "node scripts/control/clean.mjs",
    "build:mac": "bash scripts/build-mac.sh",
    "build:mac:fast": "bash scripts/build-mac.sh --skip-tests --open",
    "build:windows": "bash scripts/build-windows.sh"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.1",
    "@codemirror/commands": "^6.3.0",
    "@codemirror/lang-markdown": "^6.2.5",
    "@codemirror/language": "^6.10.1",
    "@codemirror/lint": "^6.9.5",
    "@codemirror/search": "^6.5.6",
    "@codemirror/state": "^6.4.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.26.3",
    "@milkdown/kit": "^7.18.0",
    "@milkdown/react": "^7.18.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.9.0",
    "@uiw/react-codemirror": "^4.24.2",
    "dompurify": "^3.3.2",
    "katex": "^0.17.0",
    "marked": "^12.0.2",
    "mdast-util-find-and-replace": "^3.0.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^4.5.4"
  },
  "pnpm": {
    "overrides": {
      "micromark-extension-gfm-table": "2.1.2",
      "picomatch": ">=4.0.4",
      "rollup": ">=4.59.0"
    },
    "patchedDependencies": {
      "prosemirror-tables@1.8.5": "patches/prosemirror-tables@1.8.5.patch"
    }
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@testing-library/dom": "^10.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.1.0",
    "@types/katex": "^0.16.8",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "@vitest/coverage-v8": "^3.2.4",
    "jsdom": "^26.1.0",
    "typescript": "~5.8.3",
    "vite": "^7.3.1",
    "vitest": "^3.2.4"
  }
}
