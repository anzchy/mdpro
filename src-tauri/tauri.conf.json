{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mdpro",
  "version": "0.3.0",
  "identifier": "com.mdpro.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "mdpro",
        "width": 1200,
        "height": 800,
        "minWidth": 400,
        "minHeight": 640,
        "resizable": true,
        "dragDropEnabled": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "devtools": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: https://asset.localhost https: data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-eval'",
      "assetProtocol": {
        "enable": true,
        "scope": ["**/*"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "externalBin": [
      "binaries/mdpro_mcp"
    ],
    "fileAssociations": [
      {
        "ext": ["md", "markdown"],
        "name": "Markdown Document"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA4MDU4RUZFMkY0NDE5RDcKUldUWEdVUXYvbzRGQ0kvY1drZkxrQWhWK29MZ2svWkx3azZoNUQ3dkl0RjlQSm5hdUZkS2lZTE4K",
      "endpoints": [
        "https://github.com/anzchy/mdpro/releases/latest/download/latest.json"
      ]
    }
  }
}
